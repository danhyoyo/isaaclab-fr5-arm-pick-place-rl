#usda 1.0
(
    customLayerData = {
        string inertia_method = "uniform closed convex hull of original collision mesh, normalized to assigned mass"
        string mass_reference = "https://github.com/FAIR-INNOVATION/frcobot_ros2/blob/main/fairino_description/urdf/fairino5_v6.urdf"
        string status = "simulation_estimates_not_calibrated"
    }
    defaultPrim = "fr5_robot"
    metersPerUnit = 1
    subLayers = [
        @fr5_withgripper.usd@
    ]
    upAxis = "Z"
)

over "fr5_robot"
{
    over "base_link" (
        prepend apiSchemas = ["PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (-0.000001829609, 0.0000019235447, 0.031535666)
        float3 physics:diagonalInertia = (0.002887166, 0.0028874208, 0.0038060902)
        float physics:mass = 1.6185
        quatf physics:principalAxes = (-0.3988523, -0.000025711855, 0.000069559435, 0.9170152)
    }

    over "shoulder_Link" (
        prepend apiSchemas = ["PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0.0000020957348, -0.061668817, -0.00564543)
        float3 physics:diagonalInertia = (0.008848053, 0.01320032, 0.013385062)
        float physics:mass = 4.64
        quatf physics:principalAxes = (0.50866127, -0.49115846, -0.5080219, 0.4918748)
    }

    over "upperarm_Link" (
        prepend apiSchemas = ["PhysicsMassAPI"]
