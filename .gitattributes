* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.urdf text eol=lf
*.xml text eol=lf
*.usda text eol=lf
*.ps1 text eol=crlf

# Preserve source bytes for copied upstream license texts and the manifest.
licenses/*.txt -text
fr5_preparation/package/source_manifest.json -text
fr5_preparation/package/fr5_description/urdf/fr5_withgripper.original.urdf -text

# Install Git LFS before adding simulation assets to the repository.
*.usd filter=lfs diff=lfs merge=lfs -text
*.usdc filter=lfs diff=lfs merge=lfs -text
*.stl filter=lfs diff=lfs merge=lfs -text
*.STL filter=lfs diff=lfs merge=lfs -text
*.dae filter=lfs diff=lfs merge=lfs -text
*.DAE filter=lfs diff=lfs merge=lfs -text
