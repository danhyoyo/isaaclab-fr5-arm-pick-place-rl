#usda 1.0
(
    defaultPrim = "cumotion_arm"
    metersPerUnit = 1
    upAxis = "Z"
    subLayers = [@cumotion_arm.usd@]
)

# The imported joint frames make negative angles move the finger toward the
# fixed jaw. Keep the original robot untouched; correct only its allowed range.
over "cumotion_arm"
{
    over "joints"
    {
        over "cumotion_arm_joint_hand"
        {
            float physics:lowerLimit = -60
            float physics:upperLimit = 0
        }
    }
}
